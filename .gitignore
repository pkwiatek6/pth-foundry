# === Foundry VTT system ignore rules ===

# Node/npm (if you use them later)
node_modules/
package-lock.json
npm-debug.log
yarn.lock

# Build / dist outputs
dist/
build/
temp/
.tmp/

# OS / Editor junk
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor configs
.vscode/
.idea/
*.iml

# GitHub metadata (optional to ignore locally)
.github/

# Backup or test files
*.bak
*.tmp
*.swp
~$*

# Local development links (don’t commit the symlink target)
# NOTE: This only matters if you ever link this folder inside another repo
Data/
systems/
worlds/
modules/

# === Compendium handling ===
# Ignore everything in packs/charms except the actual charms.db file
packs/charms/*
!packs/charms/charms.db

# === Optional system-specific ignores ===

# Example system exports or cache files
cache/
logs/

# Ignore zip releases (if you build them for release)
*.zip
