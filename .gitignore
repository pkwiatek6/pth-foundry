# === Foundry VTT system ignore rules ===

# Node/npm (if you use them later)
node_modules/
package-lock.json
npm-debug.log
yarn.lock

# Build / dist outputs
dist/
build/
temp/
.tmp/

# OS / Editor junk
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor configs
.vscode/
.idea/
*.iml

# GitHub metadata (optional to ignore locally)
.github/

# Backup or test files
*.bak
*.tmp
*.swp
~$*

# Ignore built LevelDB packs
pth/packs/charms/**

# Keep JSON sources
packs/src/**


# === Optional system-specific ignores ===

# Example system exports or cache files
cache/
logs/

# Ignore zip releases (if you build them for release)
*.zip